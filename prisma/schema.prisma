generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  USER
  POLITICIAN
  EMPLOYER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VouchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum CommunityCategory {
  SC
  ST
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  GOVERNMENT
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

enum ScholarshipStatus {
  OPEN
  UPCOMING
  CLOSED
}

enum IssueStatus {
  REPORTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportTargetType {
  USER
  POLITICIAN
  JOB
  SCHOLARSHIP
  ISSUE
  MATRIMONY_PROFILE
  MESSAGE
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  SYSTEM
  VERIFICATION
  VOUCH
  CONNECTION
  JOB
  SCHOLARSHIP
  POLITICIAN_UPDATE
  MATRIMONY
  MESSAGE
}

// -------------------------------------------------------------
// CORE & USER MODELS
// -------------------------------------------------------------

model User {
  id              String            @id @default(cuid())
  phone           String?           @unique
  email           String?           @unique
  name            String
  role            Role              @default(USER)
  level           Int               @default(0) // Level 0: Visitor, Level 1: Phone OTP, Level 2: SC/ST Verified
  community       CommunityCategory?
  subCaste        String?
  state           String?
  district        String?
  taluka          String?
  village         String?
  avatarUrl       String?
  isPhoneVerified Boolean           @default(false)
  verifiedAt      DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Verification & Vouches
  verificationRequests    VerificationRequest[]   @relation("UserVerificationRequests")
  reviewedVerifications   VerificationRequest[]   @relation("ReviewerVerificationRequests")
  vouchesGiven            Vouch[]                 @relation("VoucherUser")
  vouchesReceived         Vouch[]                 @relation("VoucheeUser")

  // Connections / My Network
  connectionsSent         Connection[]            @relation("ConnectionSender")
  connectionsReceived     Connection[]            @relation("ConnectionReceiver")

  // Module profiles
  politician              Politician?
  employer                Employer?
  matrimonyProfile        MatrimonyProfile?
  resumes                 Resume[]
  jobApplications         JobApplication[]
  savedJobs               SavedJob[]
  scholarshipTracks       ScholarshipTrack[]

  // Civic issues & feedback
  reportedIssues          Issue[]                 @relation("ReportedByUser")
  issueUpdates            IssueUpdate[]
  feedbacks               Feedback[]

  // Messaging & Conversations
  conversations1          Conversation[]          @relation("ConversationUser1")
  conversations2          Conversation[]          @relation("ConversationUser2")
  messagesSent            Message[]

  // Shared
  notifications           Notification[]
  reportsFiled            Report[]                @relation("Reporter")
  auditLogs               AuditLog[]
  chatReports             ChatReport[]

  @@index([role])
  @@index([level])
  @@index([state, district])
  @@index([community])
}

// -------------------------------------------------------------
// VERIFICATION & COMMUNITY VOUCHING (Phase 7)
// -------------------------------------------------------------

model VerificationRequest {
  id                 String             @id @default(cuid())
  userId             String
  community          CommunityCategory
  subCaste           String?
  certificateNumber  String
  certificateDocUrl  String
  idDocUrl           String?
  status             VerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy         User?              @relation("ReviewerVerificationRequests", fields: [reviewedById], references: [id])
  vouches            Vouch[]

  @@index([userId])
  @@index([status])
}

model Vouch {
  id                    String              @id @default(cuid())
  verificationRequestId String
  voucherId             String
  voucheeId             String
  status                VouchStatus         @default(PENDING)
  comment               String?
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  voucher               User                @relation("VoucherUser", fields: [voucherId], references: [id], onDelete: Cascade)
  vouchee               User                @relation("VoucheeUser", fields: [voucheeId], references: [id], onDelete: Cascade)

  @@unique([verificationRequestId, voucherId])
  @@index([verificationRequestId])
  @@index([voucherId])
  @@index([voucheeId])
}

// -------------------------------------------------------------
// MY NETWORK (RELATIONSHIPS & KINSHIP)
// -------------------------------------------------------------

model RelationType {
  id                   String        @id @default(cuid())
  code                 String        @unique // e.g. FATHER, MOTHER, SON, DAUGHTER, BROTHER, SISTER, SPOUSE, FRIEND, RELATIVE
  nameEn               String
  nameGu               String
  nameHi               String
  inverseRelationCode  String?
  isSymmetric          Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  connections          Connection[]

  @@index([code])
}

model Connection {
  id             String           @id @default(cuid())
  senderId       String
  receiverId     String
  relationTypeId String
  status         ConnectionStatus @default(PENDING)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sender         User             @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  relationType   RelationType     @relation(fields: [relationTypeId], references: [id])

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

// -------------------------------------------------------------
// POLITICIAN MODULE
// -------------------------------------------------------------

model Politician {
  id               String           @id @default(cuid())
  userId           String           @unique
  constituency     String
  constituencyType String           // e.g. LOK_SABHA, VIDHAN_SABHA, PANCHAYAT, ZILLA_PARISHAD
  party            String
  designation      String
  state            String
  district         String
  reservedSeat     Boolean          @default(true)
  termStart        DateTime?
  termEnd          DateTime?
  bio              String?
  officeAddress    String?
  contactEmail     String?
  contactPhone     String?
  bannerUrl        String?
  isVerified       Boolean          @default(false)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  works            PoliticianWork[]
  criminalCases    CriminalCase[]
  announcements    Announcement[]
  events           Event[]
  feedbacks        Feedback[]
  issuesAssigned   Issue[]

  @@index([state, district])
  @@index([constituency])
  @@index([party])
}

model PoliticianWork {
  id              String      @id @default(cuid())
  politicianId    String
  title           String
  description     String
  category        String      // e.g. INFRASTRUCTURE, EDUCATION, HEALTHCARE, WELFARE
  budgetAllocated Float?
  budgetSpent     Float?
  sanctionDate    DateTime?
  completionDate  DateTime?
  status          String      @default("COMPLETED") // PROPOSED, ONGOING, COMPLETED
  location        String?
  proofDocUrls    String[]
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  politician      Politician  @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([category])
}

model CriminalCase {
  id           String      @id @default(cuid())
  politicianId String
  caseNumber   String
  court        String
  charges      String
  ipcSections  String?
  status       String      // PENDING, ACQUITTED, CONVICTED
  filingDate   DateTime?
  details      String?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  politician   Politician  @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([status])
}

model Announcement {
  id           String      @id @default(cuid())
  politicianId String
  title        String
  content      String
  isPinned     Boolean     @default(false)
  mediaUrls    String[]
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  politician   Politician  @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([isPinned])
}

model Event {
  id           String      @id @default(cuid())
  politicianId String
  title        String
  description  String
  venue        String
  startDate    DateTime
  endDate      DateTime?
  isPublic     Boolean     @default(true)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  politician   Politician  @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([startDate])
}

model Feedback {
  id           String      @id @default(cuid())
  politicianId String
  userId       String
  rating       Int         // 1 to 5
  sentiment    String?     // POSITIVE, NEUTRAL, CRITICAL
  comments     String
  isAnonymous  Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  politician   Politician  @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([userId])
}

model Issue {
  id           String        @id @default(cuid())
  title        String
  description  String
  category     String        // ROADS, WATER, ELECTRICITY, DISCRIMINATION, SCHOLARSHIP_DELAY, OTHER
  priority     IssuePriority @default(MEDIUM)
  status       IssueStatus   @default(REPORTED)
  state        String
  district     String
  taluka       String?
  village      String?
  address      String?
  photoUrls    String[]
  reporterId   String
  politicianId String?
  isPublic     Boolean       @default(true)
  resolvedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  reporter     User          @relation("ReportedByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  politician   Politician?   @relation(fields: [politicianId], references: [id])
  updates      IssueUpdate[]

  @@index([reporterId])
  @@index([politicianId])
  @@index([status])
  @@index([state, district])
}

model IssueUpdate {
  id              String       @id @default(cuid())
  issueId         String
  authorId        String
  note            String
  statusChangedTo IssueStatus?
  mediaUrls       String[]
  createdAt       DateTime     @default(now())

  issue           Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([authorId])
}

// -------------------------------------------------------------
// MESSAGING & REALTIME
// -------------------------------------------------------------

model Conversation {
  id            String    @id @default(cuid())
  user1Id       String
  user2Id       String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user1         User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// MATRIMONY MODULE
// -------------------------------------------------------------

model MatrimonyProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  gender              Gender
  dateOfBirth         DateTime
  heightCm            Int?
  community           CommunityCategory
  subCaste            String
  gotra               String?
  manglik             Boolean           @default(false)
  education           String
  occupation          String
  annualIncome        Float?
  maritalStatus       MaritalStatus     @default(NEVER_MARRIED)
  diet                String?           // VEGETARIAN, NON_VEGETARIAN, EGGETARIAN, JAIN
  motherTongue        String            @default("Gujarati")
  aboutMe             String
  partnerExpectations String?
  city                String
  district            String
  state               String
  photoUrls           String[]
  isVisible           Boolean           @default(true)
  isVerified          Boolean           @default(false)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialLinks         SocialLink[]
  interestsSent       InterestRequest[] @relation("InterestSender")
  interestsReceived   InterestRequest[] @relation("InterestReceiver")
  shortlistsTargeted  Shortlist[]       @relation("ShortlistedTarget")
  shortlistsMade      Shortlist[]       @relation("ShortlistOwner")

  @@index([gender])
  @@index([community, subCaste])
  @@index([state, district])
}

model SocialLink {
  id                 String           @id @default(cuid())
  matrimonyProfileId String
  platform           String           // INSTAGRAM, LINKEDIN, FACEBOOK, TWITTER
  url                String
  isPrivate          Boolean          @default(true)
  createdAt          DateTime         @default(now())

  matrimonyProfile   MatrimonyProfile @relation(fields: [matrimonyProfileId], references: [id], onDelete: Cascade)

  @@index([matrimonyProfileId])
}

model InterestRequest {
  id                String           @id @default(cuid())
  senderProfileId   String
  receiverProfileId String
  status            String           @default("PENDING") // PENDING, ACCEPTED, DECLINED
  message           String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  senderProfile     MatrimonyProfile @relation("InterestSender", fields: [senderProfileId], references: [id], onDelete: Cascade)
  receiverProfile   MatrimonyProfile @relation("InterestReceiver", fields: [receiverProfileId], references: [id], onDelete: Cascade)

  @@unique([senderProfileId, receiverProfileId])
  @@index([senderProfileId])
  @@index([receiverProfileId])
  @@index([status])
}

model Shortlist {
  id              String           @id @default(cuid())
  ownerProfileId  String
  targetProfileId String
  notes           String?
  createdAt       DateTime         @default(now())

  ownerProfile    MatrimonyProfile @relation("ShortlistOwner", fields: [ownerProfileId], references: [id], onDelete: Cascade)
  targetProfile   MatrimonyProfile @relation("ShortlistedTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([ownerProfileId, targetProfileId])
  @@index([ownerProfileId])
  @@index([targetProfileId])
}

// -------------------------------------------------------------
// JOBS MODULE
// -------------------------------------------------------------

model Employer {
  id              String    @id @default(cuid())
  userId          String    @unique
  companyName     String
  industry        String
  companySize     String?
  website         String?
  logoUrl         String?
  verifiedCompany Boolean   @default(false)
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  approvedById    String?
  state           String
  city            String
  address         String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs            Job[]

  @@index([companyName])
  @@index([isApproved])
  @@index([state, city])
}

model Job {
  id                 String             @id @default(cuid())
  employerId         String?
  organizationName   String?
  title              String
  description        String
  requirements       String
  category           String             // IT, ENGINEERING, BANKING, HEALTHCARE, GOVERNMENT_PSC, SKILLED_LABOR, EDUCATION
  sector             String             @default("PRIVATE") // GOVERNMENT, PRIVATE, PSU
  jobType            JobType            @default(FULL_TIME)
  workplaceType      WorkplaceType      @default(ON_SITE)
  qualification      String             @default("ANY") // 10TH_PASS, 12TH_PASS, DIPLOMA, GRADUATE, POST_GRADUATE, BTECH, MBBS, ANY
  quota              String?            // SC, ST, GENERAL, ALL
  ageRelaxation      String?            // e.g. "Up to 5 years for SC/ST"
  minAge             Int?
  maxAge             Int?
  state              String
  district           String?
  city               String?
  minSalary          Float?
  maxSalary          Float?
  isReservedForScSt  Boolean            @default(false)
  targetCommunity    CommunityCategory?
  vacancies          Int                @default(1)
  deadline           DateTime?
  howToApplySteps    String[]
  officialUrl        String?            // Official portal link
  sourceUrl          String?            // Mandatory official source URL
  syllabusUrl        String?            // Syllabus link / exam guidance
  admitCardUrl       String?            // Admit card link
  resultUrl          String?            // Results link
  isExternal         Boolean            @default(false) // True for external/govt portal applications
  status             String             @default("ACTIVE") // ACTIVE, EXPIRED, ARCHIVED, PENDING_APPROVAL
  isActive           Boolean            @default(true)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  employer           Employer?          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications       JobApplication[]
  savedBy            SavedJob[]

  @@index([employerId])
  @@index([category])
  @@index([sector])
  @@index([qualification])
  @@index([jobType])
  @@index([state])
  @@index([isReservedForScSt])
}

model JobApplication {
  id              String            @id @default(cuid())
  jobId           String
  applicantId     String
  resumeId        String?
  coverLetter     String?
  status          String            @default("APPLIED") // APPLIED, INTERVIEW, SELECTED, REJECTED
  statusNotes     String?
  isExternalTrack Boolean           @default(false) // For manual tracking of external government jobs
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant       User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resume          Resume?           @relation(fields: [resumeId], references: [id])

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([status])
}

model SavedJob {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  alertSent Boolean  @default(false)
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model Resume {
  id              String           @id @default(cuid())
  userId          String
  title           String           @default("Primary Resume")
  fullName        String?
  email           String?
  phone           String?
  summary         String?
  qualification   String?          // User's saved qualification for smart job suggestions
  education       Json?            // Array of [{ degree, institute, year, marks }]
  experience      Json?            // Array of [{ title, company, duration, description }]
  skills          String[]
  experienceYears Int?
  isDefault       Boolean          @default(false)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    JobApplication[]

  @@index([userId])
}

// -------------------------------------------------------------
// SCHOLARSHIPS MODULE
// -------------------------------------------------------------

model Scholarship {
  id                     String             @id @default(cuid())
  title                  String
  provider               String             // e.g. Ministry of Social Justice & Empowerment, Gujarat Govt, Tata Trusts
  description            String
  eligibilityCriteria    String
  community              CommunityCategory? // SC, ST, or null for both
  minPercentage          Float?
  maxFamilyIncome        Float?
  educationLevel         String             // MATRIC, INTERMEDIATE, UNDERGRADUATE, POSTGRADUATE, PHD, OVERSEAS
  category               String             @default("POST_MATRIC") // PRE_MATRIC, POST_MATRIC, HIGHER_STUDY, ABROAD, COACHING, HOSTEL
  course                 String?            // ALL, STEM, MEDICAL, LAW, GENERAL
  classLevel             String?            // CLASS_9_10, CLASS_11_12, DIPLOMA, UG, PG, PHD
  awardAmount            Float?
  deadline               DateTime?
  applicationUrl         String?
  officialPdfUrl         String?
  sourceUrl              String?
  howToApplySteps        String[]
  documentsRequired      String[]
  commonRejectionReasons String[]
  state                  String?            // Specific state or null for national
  isNational             Boolean            @default(false)
  status                 ScholarshipStatus  @default(OPEN)
  lastVerifiedAt         DateTime?          @default(now())
  deletedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tracks                 ScholarshipTrack[]

  @@index([community])
  @@index([educationLevel])
  @@index([category])
  @@index([deadline])
  @@index([status])
}

model ScholarshipTrack {
  id              String      @id @default(cuid())
  scholarshipId   String
  userId          String
  status          String      @default("INTERESTED") // INTERESTED, APPLIED, RECEIVED, REJECTED
  applicationDate DateTime?
  notes           String?
  checklistState  Json?
  alert7d         Boolean     @default(false)
  alert3d         Boolean     @default(false)
  alert1d         Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  scholarship     Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, userId])
  @@index([userId])
  @@index([scholarshipId])
  @@index([status])
}

// -------------------------------------------------------------
// SHARED: NOTIFICATIONS, REPORTS, AUDIT LOG
// -------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      String
  description String?
  status      ReportStatus     @default(PENDING)
  actionTaken String?
  reviewedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter    User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. AUTH_LOGIN, VERIFICATION_SUBMIT, JOB_APPLY, PROFILE_UPDATE
  entityType String   // e.g. User, VerificationRequest, Job, Issue
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// OTP & SESSION MODELS (Phase 7)
// -------------------------------------------------------------

model OtpAttempt {
  id          String   @id @default(cuid())
  phone       String   // Phone number the OTP was sent to
  otpHash     String   // Hashed OTP code
  attempts    Int      @default(0) // Number of verification attempts
  expiresAt   DateTime // When the OTP expires
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([expiresAt])
}

model Session {
  id            String   @id @default(cuid())
  userId        String   @unique // One active session per user (for logout everywhere)
  tokenHash     String   // Hashed session token stored in cookie
  createdAt     DateTime @default(now())
  expiresAt     DateTime // Session expiration
  deviceInfo    String?  // Optional device identifier / user-agent
  ipAddress     String?  // Optional IP address

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// -------------------------------------------------------------
// PLACEHOLDER ChatReport model (Phase 7) – can be expanded later
// -------------------------------------------------------------

model ChatReport {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
}
